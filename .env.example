WORKOS_CLIENT_ID=client_
WORKOS_API_KEY=sk_test_
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# WorkOS dashboard Redirects:
# - Redirect URI: http://localhost:3000/api/auth/callback
# - Sign-in endpoint: http://localhost:3000/api/auth/sign-in
# - Sign-out redirect: http://localhost:3000/
# Cookie password: openssl rand -base64 24  (32+ characters)
# AuthKit: Italian fallback locale, Email magic link + Google, no passwords.

DATABASE_URL=postgres://parle:parle@localhost:5432/parle
# Local: docker compose up -d && pnpm run db:migrate

# Web Push (Account Notifications). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects POST /api/cron/notifications
CRON_SECRET=
# Public origin of the app (cron script + Railway notifications-cron)
PARLE_URL=http://localhost:3000
